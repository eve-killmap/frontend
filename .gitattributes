# Normalize line endings: text files are LF in the repo and the working tree.
# Prevents CRLF churn on Windows (core.autocrlf) and keeps Prettier
# (endOfLine: "lf") green across checkouts.
* text=auto eol=lf

# Binary assets, never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.ico binary
